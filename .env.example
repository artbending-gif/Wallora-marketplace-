# Runtime application traffic: use Neon's pooled URL (hostname contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# CLI migrations only: use Neon's direct URL (hostname does not contain -pooler).
# Do not add this secret to Netlify unless you intentionally run migrations there.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# Who owns the store. Set this BEFORE the first production deploy.
# Comma-separated. When set, only these emails can open the owner console.
ADMIN_EMAILS=you@example.com
